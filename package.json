{
  "name": "bigtex",
  "productName": "BigTeX",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-first Electron LaTeX editor prototype.",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:perf": "BIGTEX_PERF_PROFILE=1 electron-vite build",
    "perf:trace": "tsx scripts/perf/trace-electron.ts",
    "perf:trace:dev": "BIGTEX_PERF_DEV=1 tsx scripts/perf/trace-electron.ts",
    "perf": "pnpm run build:perf && pnpm run perf:trace",
    "perf:parse": "tsx scripts/perf/parse-trace-cli.ts",
    "postinstall": "node scripts/patch-electron-mac-name.mjs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "sh scripts/pre-commit.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "simple-git-hooks"
    ],
    "overrides": {
      "vscode-jsonrpc": "6.0.0",
      "vscode-languageserver-protocol": "3.16.0"
    }
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.28",
    "@lobehub/icons": "^5.8.0",
    "@monaco-editor/react": "latest",
    "@shikijs/langs": "4.0.2",
    "@shikijs/themes": "4.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron-updater": "latest",
    "geist": "^1.7.0",
    "monaco-editor": "latest",
    "monaco-languageclient": "^0.18.1",
    "pdfjs-dist": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "react-resizable-panels": "^4.11.0",
    "react-shiki": "latest",
    "remark-gfm": "latest",
    "shiki": "4.0.2",
    "vscode-jsonrpc": "6.0.0",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "latest",
    "electron-vite": "latest",
    "playwright": "latest",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "^7.3.3",
    "vitest": "^4.1.6"
  }
}
